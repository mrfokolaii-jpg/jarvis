{
  "name": "Jarvis",
  "baseProject": {
    "name": "Zafiro",
    "repository": "https://github.com/niki914/zafiro",
    "strategy": "replace-existing-base"
  },
  "language": {
    "default": "fa",
    "fallback": "en"
  },
  "voice": {
    "enabled": true,
    "continuousConversation": true,
    "floatingWidget": true,
    "readRepliesAloud": true,
    "showTranscript": true
  },
  "autoApi": {
    "enabled": true,
    "providers": [
      {
        "slot": 1,
        "enabled": true,
        "priority": 1,
        "failoverOn": ["429", "408", "500", "502", "503", "504", "timeout", "quota"]
      },
      {
        "slot": 2,
        "enabled": true,
        "priority": 2,
        "failoverOn": ["429", "408", "500", "502", "503", "504", "timeout", "quota"]
      }
    ],
    "preserveConversationContext": true,
    "retrySameRequest": true
  },
  "permissions": {
    "requireConfirmationForSensitiveActions": true,
    "phoneControl": true,
    "screenAwareness": true,
    "webSearch": true,
    "githubTools": true,
    "fileTools": true
  }
}
